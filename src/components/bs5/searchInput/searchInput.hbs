<!-- 
    QGDS Component: Search input 
-->
<{{#if form}}form{{#if form.action}} action="{{form.action}}"{{/if}} method="{{isdefined form.method 'GET'}}" {{~#if form.target}} target="{{form.target}}" {{/if~}} {{~#ifCond form.target "===" "_blank"}} rel="noopener noreferrer" {{/ifCond~}} 
    {{~else}}div {{/if~}} 
    {{~#if containerID}} id="{{containerID}}" {{/if~}}
    class="qld-search-input {{customClass}}" role="search" data-search-delay="{{isdefined searchDelay 300}}" 
    {{~#if ariaLabelContainer}} aria-label="{{ ariaLabelContainer }}" {{/if~}} 
    {{~#if initialSuggestions}} data-suggestions="{{stringify initialSuggestions}}" {{/if~}}
    {{~#if dynamicSuggestions}} data-dynamic-suggestions="{{stringify dynamicSuggestions}}" {{/if~}}
    >
    <input id="{{ inputID }}" name="{{ inputName }}" class="form-control" type="text" autocomplete="off"
        aria-label="{{ ariaLabel }}" placeholder="{{placeholder}}" role="searchbox" enterkeyhint="search"/>
    <button class="btn btn-primary js-search-button" {{#if buttonID }}id="{{ buttonID }}"{{/if}} type="{{#if form}}submit{{else}}{{isdefined buttonType "button"}}{{/if}}" 
        aria-label="{{ buttonLabel }}">
        <span class="btn-icon" aria-hidden="true"></span>
        <span class="btn-label" aria-hidden="true">{{ buttonLabel }}</span>
    </button>
    {{#each searchParams}}
    <input id="{{../inputID}}_{{@key}}" name="{{@key}}" value="{{this}}" type="hidden" />
    {{/each}}
    <div class="suggestions default">
        <div class="suggestions-inner"></div>
    </div>
</{{#if form}}form{{else}}div{{/if}}>