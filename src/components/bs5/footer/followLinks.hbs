{{#if followLinks }}
    <ul class="nav footer-link-list footer-link-list--social">    
    {{#each followLinks }}
      <li>
          <a class="nav-link" href="{{ link }}" {{#if target}}target="{{ target }}"{{/if}} aria-label="{{isdefined accessibleLabel label}}">
              <span class="qld-icon qld-icon-{{icon}}" aria-hidden="true"></span>
              <span class="nav-link-label d-none d-lg-block">{{ label }}</span>
          </a>
      </li>
    {{/each }}
    </ul>
{{/if}}