{{#*inline "promoBackgroundImage"~}}
    {{#ifCond type '==' 'promo'}}
        {{#if promoImage}}style="background-image: url('{{promoImage}}');"{{/if}}
    {{/ifCond}}
{{~/inline}}

{{#*inline "nonPromoImageTag"~}}
    {{#ifCond type '!=' 'promo'}}
        {{#if promoImage}}
        <img src="{{promoImage}}" alt="{{promoImageDescription}}">
        {{/if}}
    {{/ifCond}}
{{~/inline}}

{{! Promotional Panel component markup }}
<section class="qld-promo-panel {{isdefined type 'contained'}} {{isdefined variantClass 'default'}} {{#ifCond contentAlignment '===' 'content-right'}}content-right{{else}}content-left{{/ifCond}} {{#ifCond type 'in' 'indent-text,indent-img'}}indent{{/ifCond}}">
    <div class="promo-panel-container" {{> promoBackgroundImage}}>

        <div class="image-panel">
            {{> nonPromoImageTag}}
        </div>

        <div class="content-panel">
            {{#if icon}}
                <div class="icon-container">
                    <div class="icon-body">
                        <i class="qld-icon {{icon}}"></i>
                    </div>
                </div>
            {{/if}}
            <div class="main">
                {{#if title}}
    {{#ifCond headingTag 'in' 'h2,h3,h4,h5,h6'}}
        <{{headingTag}} class="promo-title">{{~{title}~}}</{{headingTag}}>
    {{else}}
        <h2 class="promo-title">{{~{title}~}}</h2>
    {{/ifCond}}
{{/if}}
                {{#if abstract}}
                    <div class="promo-abstract">
                        {{~{abstract}~}}
                    </div>
                {{/if}}
                {{#if body}}
                    {{~{body}~}}
                {{/if}}
            </div>
            {{#if cta.items}}
                <div class="cta-container">
                    {{#each cta.items}}
                        {{> callToAction label=value href=url target=target class=class arialabel=value id=id}}
                    {{/each}}
                </div>
            {{/if}}
            {{#if btn.items}}
                <div class="btn-container">
                    {{#each btn.items}}
                        {{> button islink=islink variantClass=variantClass label=label href=href target=target dataatts="data-type='class'"}}
                    {{/each}}
                </div>
            {{/if}}
        </div>
    </div>
</section>